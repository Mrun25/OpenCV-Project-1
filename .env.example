# fumii Pipeline — Environment Variables
# Copy to .env and fill in your values before running any pipeline step.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Teacher model (Claude Sonnet) + Judge model — required for all pipeline stages
ANTHROPIC_API_KEY=

# ── Optional — Cloud Fallbacks (LiteLLM fallback chain) ──────────────────────

# First cloud fallback after Ollama local
MISTRAL_API_KEY=

# Second cloud fallback
OPENAI_API_KEY=

# Third cloud fallback
GEMINI_API_KEY=

# ── Optional — Training Tracking ─────────────────────────────────────────────

# Weights & Biases — remove report_to="wandb" from train_unsloth.py / train_dpo.py
# if you don't want to use this
WANDB_API_KEY=
WANDB_PROJECT=fumii-training

# ── Integration ───────────────────────────────────────────────────────────────

LITELLM_PORT=4000
OLLAMA_URL=http://localhost:11434
